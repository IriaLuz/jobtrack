# Copy to .env and adjust. `docker compose up -d db` (from the repo root) starts a matching database.
DATABASE_URL="postgresql://jobtrack:jobtrack@localhost:5433/jobtrack"

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET="replace-me-with-a-long-random-secret-at-least-32-chars"

PORT=3000

# Optional. Without a key the AI features fall back to the question bank.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional. Without a DSN errors are only logged to the console.
SENTRY_DSN=
